<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.penocean.ehs.mapper.VesselMapper">

  <resultMap id="VesselResultMap" type="com.penocean.ehs.model.Vessel">
    <id property="id" column="id"/>
    <result property="code" column="code"/>
    <result property="name" column="name"/>
    <result property="imoNumber" column="imo_number"/>
    <result property="flag" column="flag"/>
    <result property="vesselType" column="vessel_type"/>
    <result property="dwt" column="dwt"/>
    <result property="status" column="status"/>
    <result property="currentPort" column="current_port"/>
    <result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
    <result property="deleted" column="deleted"/>
  </resultMap>

  <sql id="vesselColumns">
    id, code, name, imo_number, flag, vessel_type, dwt, status, current_port,
    created_at, updated_at, deleted
  </sql>

  <select id="findById" resultMap="VesselResultMap">
    SELECT <include refid="vesselColumns"/>
      FROM tb_vessel
     WHERE id = #{id} AND deleted = 0
  </select>

  <select id="findAll" resultMap="VesselResultMap">
    SELECT <include refid="vesselColumns"/>
      FROM tb_vessel
     WHERE deleted = 0
     ORDER BY name
  </select>

</mapper>
